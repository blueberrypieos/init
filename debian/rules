include /usr/share/pietoolchain/rules.mk

$(OBJ)/init.o: $(SRCROOT)/init.c
	@mkdir -p $(OBJ)
	$(CC) $(BASE_CFLAGS) -c $< -o $@

$(OBJ)/init: $(OBJ)/init.o
	$(CC) $(BASE_LDFLAGS) $< -lbsm -o $@

install: $(OBJ)/init
	install -d $(ROOT)/sbin
	install -m 755 $(OBJ)/init $(ROOT)/sbin/launchd

.PHONY: install
